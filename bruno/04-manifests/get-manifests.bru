meta {
  name: List figures (latest first)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/manifests
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.total: gt 0
  res.body.limit: eq 20
  res.body.items.length: lte 20
  res.body.items[0].costUsd: isNumber
  res.body.items[0].seconds: gt 0
  res.body.items[0].createdAt: isString
}
