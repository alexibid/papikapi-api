{
  "system": "auto",
  "workspace": {
    "models_dir": "public/models",
    "resources_dir": "resources",
    "models_from": "resources/*/stage-1/step-2-art.jpeg",
    "sheet_language": "pt",
    "sheet_translations": "scripts/stage-4/sheet-translations.json"
  },
  "pricing": {
    "runpod_trellis_usd_per_sec": 0.00069,
    "runpod_flux_usd_per_sec": 0.00015,
    "local_processing_usd": 0,
    "flux_models": {
      "black-forest-labs/FLUX.2-klein-4B": 0.00015
    }
  },
  "pipeline_stages": [
    {
      "stage": "Stage 1: 3D Papercraft Figure Alternatives & Selection",
      "steps": [
        {
          "id": "s1-step-1",
          "name": "Alternatives Sheet Generation",
          "label": "ALTERNATIVES",
          "emoji": "🎨",
          "expected_seconds": 20,
          "script": "scripts/stage-1/step-1-alternatives.ts",
          "models_from": "resources/*/stage-1/step-2-art.jpeg",
          "skip_if_outputs_exist": true,
          "serverless": {
            "env_endpoint_key": "RUNPOD_FLUX_ENDPOINT_ID",
            "container_image": "ghcr.io/alexibid/papikapi-flux:latest",
            "min_workers": 0,
            "max_workers": 2,
            "idle_timeout_seconds": 5,
            "client_timeout_seconds": 900,
            "gpu_vram": "24GB",
            "api_url_pattern": "https://api.runpod.ai/v2/{endpoint_id}/runsync",
            "async_url_pattern": "https://api.runpod.ai/v2/{endpoint_id}/run",
            "status_url_pattern": "https://api.runpod.ai/v2/{endpoint_id}/status/{job_id}"
          },
          "parameters": {
            "default_model": "black-forest-labs/FLUX.2-klein-4B",
            "fallback_model": "black-forest-labs/FLUX.2-klein-4B",
            "inference_engine": "flux2-klein",
            "aspect_ratio": "3:2",
            "columns": 3,
            "rows": 2,
            "alternatives_count": 6,
            "max_reference_images": 3,
            "plane_palette": {
              "black": "#202020",
              "blue": "#2E5BD8",
              "red": "#D33A2C",
              "green": "#2E9E4F",
              "orange": "#F08A24",
              "purple": "#7B4FC2",
              "yellow": "#F2C230"
            }
          },
          "messages": {
            "start": "[Stage 1: Step 1] Generating 3x2 alternatives sheet for {model}",
            "completed": "[Stage 1: Step 1] Alternatives sheet generated in {duration}s"
          },
          "stage_dir": "stage-1",
          "outputs": {
            "sheet_resource": "step-1-alternatives.jpeg",
            "manifest": "step-1-manifest.json",
            "allowed_extensions": [
              ".jpeg",
              ".jpg",
              ".png",
              ".webp"
            ],
            "sheet_public": "alternatives.jpeg",
            "public_url_pattern": "/models/{model}/alternatives.jpeg"
          },
          "manifest_contract": {
            "status": "DONE",
            "seconds": "duration",
            "costUsd": 0.00015,
            "costNote": "FLUX.2-klein-4B Inference ($0.00015)",
            "data": {
              "prompt": "prompt",
              "referenceCount": "referenceImages.length",
              "alternativesCount": 6,
              "format": "result.mime"
            }
          }
        },
        {
          "id": "s1-step-2",
          "name": "Pick & Crop Alternative",
          "label": "PICK",
          "emoji": "✂️",
          "expected_seconds": 1,
          "script": "scripts/stage-1/step-2-pick.ts",
          "stage_dir": "stage-1",
          "depends_on": {
            "step_id": "s1-step-1",
            "stage_dir": "stage-1"
          },
          "inputs": {
            "stage_dir": "stage-1",
            "sheet_resource": "step-1-alternatives.jpeg",
            "sheet_resource_prefix": "step-1-alternatives",
            "allowed_extensions": [
              ".jpeg",
              ".jpg",
              ".png",
              ".webp"
            ],
            "sheet_public": "alternatives.jpeg",
            "sheet_public_prefix": "alternatives"
          },
          "outputs": {
            "stage_dir": "stage-1",
            "art_resource": "step-2-art.jpeg",
            "manifest": "step-2-manifest.json",
            "allowed_extensions": [
              ".jpeg",
              ".jpg",
              ".png",
              ".webp"
            ],
            "art_public": "art.jpeg",
            "art_pick_resource_pattern": "step-2-art-pick-{pick}.jpeg",
            "art_pick_public_pattern": "art-pick-{pick}.jpeg",
            "public_url_pattern": "/models/{model}/art.jpeg"
          },
          "parameters": {
            "default_pick": 3,
            "jpeg_quality": 95,
            "columns": 3,
            "rows": 2
          },
          "messages": {
            "start": "[Stage 1: Step 2] Picking and cropping chosen alternative #{pick} for {model}",
            "completed": "[Stage 1: Step 2] Alternative #{pick} cropped and saved to step-2-art.jpeg in {duration}s"
          },
          "manifest_contract": {
            "status": "DONE",
            "seconds": "duration",
            "costUsd": 0,
            "costNote": "Local CPU Image Processing ($0.00)",
            "data": {
              "chosenPick": "pick",
              "artSize": "croppedBuffer.length"
            }
          }
        },
        {
          "id": "s1-step-3",
          "name": "Upscale Art",
          "label": "UPSCALE",
          "emoji": "🔍",
          "expected_seconds": 10,
          "script": "scripts/stage-1/step-3-upscale.ts",
          "stage_dir": "stage-1",
          "depends_on": {
            "step_id": "s1-step-2",
            "stage_dir": "stage-1"
          },
          "models_from": "resources/*/stage-1/step-2-art.jpeg",
          "inputs": {
            "stage_dir": "stage-1",
            "art_resource": "step-2-art.jpeg"
          },
          "outputs": {
            "stage_dir": "stage-1",
            "upscaled_resource": "step-3-upscaled.webp",
            "manifest": "step-3-manifest.json"
          },
          "parameters": {
            "python_script": "scripts/stage-1/python/upscale.py",
            "super_resolution": {
              "binary": "~/.papikapi-tools/realesrgan-full/realesrgan-ncnn-vulkan",
              "model": "realesrgan-x4plus-anime",
              "scale": 4
            }
          },
          "messages": {
            "start": "[Stage 1: Step 3] Upscaling the chosen art of {model}",
            "completed": "✔ [Stage 1: Step 3] Art of {model} upscaled with {method} in {duration}s ($0.00)"
          },
          "manifest_contract": {
            "status": "DONE",
            "costUsd": 0,
            "costNote": "Local CPU Image Processing ($0.00)"
          }
        }
      ]
    },
    {
      "stage": "Stage 2: 3D Model Generation",
      "steps": [
        {
          "id": "s2-step-1",
          "name": "TRELLIS Input",
          "label": "TRELLIS-IN",
          "emoji": "🖼️",
          "expected_seconds": 20,
          "script": "scripts/stage-2/step-1-trellis-input.ts",
          "stage_dir": "stage-2",
          "depends_on": {
            "step_id": "s1-step-3",
            "stage_dir": "stage-1"
          },
          "models_from": "resources/*/stage-1/step-3-upscaled.webp",
          "inputs": {
            "stage_dir": "stage-1",
            "art_resource": "step-3-upscaled.webp"
          },
          "outputs": {
            "stage_dir": "stage-2",
            "cutout_resource": "step-1-figure-cutout.webp",
            "trellis_input_resource": "step-1-art-cutout.webp",
            "manifest": "step-1-manifest.json"
          },
          "parameters": {
            "python_script": "scripts/stage-2/python/trellis_input.py",
            "image_size": 1024
          },
          "messages": {
            "start": "[Stage 2: Step 1] Cutting {model} out of the upscaled art for TRELLIS (SAM + ViTMatte)",
            "completed": "✔ [Stage 2: Step 1] TRELLIS input ready for {model} in {duration}s ($0.00)"
          },
          "manifest_contract": {
            "status": "DONE",
            "costUsd": 0,
            "costNote": "Local CPU Image Processing ($0.00)"
          }
        },
        {
          "id": "s2-step-2",
          "name": "3D Generation",
          "label": "3D-GLB",
          "emoji": "🧊",
          "expected_seconds": 250,
          "script": "scripts/stage-2/step-2-trellis.ts",
          "stage_dir": "stage-2",
          "depends_on": {
            "step_id": "s2-step-1",
            "stage_dir": "stage-2"
          },
          "models_from": "resources/*/stage-2/step-1-art-cutout.webp",
          "runpod_console": "https://console.runpod.io/serverless",
          "serverless": {
            "env_endpoint_key": "RUNPOD_TRELLIS_ENDPOINT_ID",
            "container_image": "ghcr.io/alexibid/papikapi-trellis2:latest",
            "min_workers": 0,
            "max_workers": 3,
            "idle_timeout_seconds": 5,
            "client_timeout_seconds": 1200,
            "gpu_vram": "24GB",
            "api_url_pattern": "https://api.runpod.ai/v2/{endpoint_id}/runsync",
            "async_url_pattern": "https://api.runpod.ai/v2/{endpoint_id}/run",
            "status_url_pattern": "https://api.runpod.ai/v2/{endpoint_id}/status/{job_id}"
          },
          "inputs": {
            "stage_dir": "stage-2",
            "trellis_input_resource": "step-1-art-cutout.webp",
            "allowed_extensions": [
              ".png"
            ]
          },
          "outputs": {
            "stage_dir": "stage-2",
            "model_resource": "step-2-3d.glb",
            "preview_resource": "step-2-preview.webp",
            "manifest": "step-2-manifest.json",
            "model_public": "model.glb",
            "model_pick_resource_pattern": "step-2-3d-pick-{pick}.glb",
            "public_url_pattern": "/models/{model}/model.glb"
          },
          "engine": {
            "model": "microsoft/TRELLIS.2-4B",
            "type": "image-to-3d",
            "notes": "Same build and settings as the official Space (huggingface.co/spaces/microsoft/TRELLIS.2): resolution 1024, random seed, decimation 500000, texture 2048."
          },
          "parameters": {
            "seed": "random",
            "resolution": "1024",
            "decimation_target": 500000,
            "texture_size": 2048,
            "plinth": {
              "flatten_tolerance_ratio": 0.03,
              "edge_inset_ratio": 0.01,
              "margin_ratio": 0.12,
              "sheet_thickness_ratio": 0.02,
              "sheet_gap_ratio": 0.015,
              "sheet_span_ratio": 1.3,
              "weld_epsilon": 1e-05,
              "fragment_min_triangles": 30,
              "fragment_min_thickness_ratio": 0.01,
              "plinth_hue_min_deg": 5,
              "plinth_hue_max_deg": 40,
              "plinth_min_saturation": 0.3,
              "plinth_min_value": 0.3
            },
            "quality_gate": {
              "python_script": "scripts/stage-2/python/trellis_gate.py",
              "max_attempts": 3,
              "overlap_min": 0.8,
              "parts_max": 1,
              "extra_part_penalty": 0.05,
              "parts_grid": 96,
              "part_min_share": 0.01,
              "camera_grid_px": 128,
              "camera_yaw_range_deg": [
                -180,
                175,
                5
              ],
              "camera_pitch_range_deg": [
                -10,
                40,
                5
              ],
              "camera_points_max": 60000
            }
          },
          "runner": {
            "platform": "RunPod Serverless",
            "device": "NVIDIA RTX PRO 6000 Blackwell Serverless Worker",
            "rate": "$0.00069/s ($2.49/hr active, $0.00 idle)"
          },
          "messages": {
            "start": "[Stage 2: Step 2] Generating 3D model for {model}",
            "progress": "⟳ [{runner}] Generating 3D Mesh on {device}... ({elapsed}s elapsed)",
            "completed": "✔ [{runner}] 3D Model generated: {sizeMb} MB in {duration}s (${costUsd})",
            "cache_hit": "⚡ [Cache Hit] Restored 3D Model for pick #{pick} from local cache (0.0s, $0.0000)"
          },
          "manifest_contract": {
            "status": "DONE",
            "seconds": "duration",
            "costUsd": "costUsd",
            "costNote": "RunPod Serverless ($0.00069/s)",
            "cache_cost_note": "Restored from local pick cache",
            "metrics": {
              "fileSize": "buffer.length",
              "faceCount": "result.output.face_count"
            },
            "data": {
              "fileSize": "buffer.length",
              "format": "model/gltf-binary",
              "chosenPick": "pick",
              "cached": false,
              "device": "NVIDIA RTX PRO 6000 Blackwell Serverless Worker",
              "parameters": {
                "seed": "seed",
                "resolution": "resolution",
                "decimation_target": "decimation_target",
                "texture_size": "texture_size"
              }
            }
          }
        }
      ]
    },
    {
      "stage": "Stage 3: Simplify and Optimize",
      "steps": [
        {
          "id": "s3-step-1",
          "name": "Simplify",
          "label": "SIMPLIFY",
          "emoji": "📐",
