          "stage_dir": "stage-3",
          "depends_on": {
            "step_id": "s2-step-2",
            "stage_dir": "stage-2"
          },
          "models_from": "resources/*/stage-2/step-2-3d.glb",
          "blender": {
            "executable": "/Applications/Blender.app/Contents/MacOS/Blender",
            "script": "scripts/stage-3/blender/key_points/key_points.py"
          },
          "inputs": {
            "stage_dir": "stage-2",
            "model_resource": "step-2-3d.glb",
            "model_pick_resource_pattern": "step-2-3d-pick-{pick}.glb",
            "art_stage_dir": "stage-2",
            "art_resource": "step-1-art-cutout.webp"
          },
          "outputs": {
            "stage_dir": "stage-3",
            "model_resource": "step-1-simplify.glb",
            "points_resource": "step-1-simplify.json",
            "manifest": "step-1-manifest.json"
          },
          "parameters": {
            "target_faces": 480,
            "max_faces": 1200,
            "face_growth": 1.25,
            "max_volume_change_percent": 25,
            "max_dimension_change_percent": 15,
