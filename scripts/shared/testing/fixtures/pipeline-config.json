          "name": "White Plinth",
          "label": "PLINTH",
          "emoji": "🏛️",
          "expected_seconds": 10,
          "script": "scripts/stage-3/step-5-plinth.ts",
          "stage_dir": "stage-3",
          "depends_on": {
            "step_id": "s3-step-4",
