        {
          "id": "s3-step-2",
          "name": "TRELLIS Atlas",
          "label": "TR-ATLAS",
          "emoji": "🧵",
          "expected_seconds": 5,
          "script": "scripts/stage-3/step-2-trellis-atlas.ts",
          "stage_dir": "stage-3",
          "depends_on": {
            "step_id": "s2-step-2",
            "stage_dir": "stage-2"
