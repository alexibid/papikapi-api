            "completed": "✔ [Stage 3: Step 1] {meshFaces} faces ({quads} quads), volume {volume}% for {model} in {duration}s ($0.00)"
          },
          "manifest_contract": {
            "status": "DONE",
            "costNote": "Local Blender headless ($0.00)"
          },
          "eyes": {
            "catchlight_value_min": 0.85,
            "catchlight_saturation_max": 0.3,
            "catchlight_area_max_ratio": 0.002,
            "pupil_value_max": 0.45,
            "pupil_distance_max": 0.22,
            "core_reach_ratio": 8.0,
            "core_min_radius_ratio": 2.0,
            "band_ratio": 0.35,
            "band_steps": 3,
            "skin_distance_min": 0.25,
            "fallback_reach_ratio": 5.0,
            "eye_roundness_min": 0.38,
            "eye_flatten_radius_ratio": 1.3,
            "eye_degenerate_ratio": 0.02,
            "camera_grid_px": 128,
            "camera_yaw_range_deg": [
              -180,
              175,
              5
            ],
            "camera_pitch_range_deg": [
              -10,
              40,
              5
            ],
            "camera_overlap_min": 0.8,
            "camera_points_max": 60000,
            "symmetry_search_ratio": 0.15,
            "eye_paint_reach_ratio": 2.5,
            "eye_facing_min": 0.2,
            "eye_surface_depth_ratio": 0.5,
            "eye_match_window_ratio": 1.5,
            "eye_match_pad_ratio": 0.25,
            "eye_match_scales": [
              0.6,
              0.65,
              0.7,
              0.75,
              0.8,
              0.85,
              0.9,
              0.95,
              1.0,
              1.05,
              1.1,
              1.15,
              1.2,
              1.25,
              1.3,
              1.35,
              1.4,
              1.45,
              1.5
            ],
            "eye_match_score_min": 0.4,
            "eye_erase_ring_px": 2,
            "camera_overlap_margin": 0.03,
            "camera_likeness_cells": 32,
